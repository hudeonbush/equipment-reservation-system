# 云端持久化配置（发布到 WorkBuddy 云端时使用）
# 复制本文件为 .env 并填入你的 Supabase PostgreSQL 连接串。
# 本地不填则自动使用 admin.db / app.db 两个 SQLite 文件。
#
# 获取方式：Supabase 控制台 → Project Settings → Database → Connection string (URI)
# 形如：postgresql://postgres:<密码>@db.<项目ID>.supabase.co:5432/postgres
DATABASE_URL=

# 可选：管理员初始密码（首次初始化 admin 库时写入；不填则随机生成并写入 ADMIN_PASSWORD.txt）
# ADMIN_PASSWORD=Admin-XXXXXX

# ============ 邮箱验证（账号安全） ============
# 注册需邮箱验证码、忘记密码需邮箱验证码。
# 配置以下 SMTP 后走真实邮件；不配置则进入「开发模式」：
# 验证码打印到服务端日志，并在接口响应 dev_code 字段返回（仅本地联调用）。
#
# QQ 邮箱：设置 → 账户 → 开启 SMTP 服务 → 生成授权码
#    SMTP_HOST=smtp.qq.com  SMTP_PORT=465  SMTP_USER=你的QQ号@qq.com
# 163 邮箱：设置 → POP3/SMTP/IMAP → 开启 SMTP → 新增授权码
#    SMTP_HOST=smtp.163.com  SMTP_PORT=465  SMTP_USER=你的账号@163.com
# SMTP_PASS 填「授权码」而不是邮箱登录密码。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# MAIL_FROM=可选，默认等于 SMTP_USER
